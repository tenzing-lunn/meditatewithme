{
  "name": "meditatewithme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "contrast": "node scripts/contrast.mjs",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "test:api": "node --test --experimental-strip-types --import ./tests/api/_register.mjs \"tests/api/*.test.ts\"",
    "timelog": "node scripts/timelog.mjs",
    "live:key": "node --env-file=.env.local scripts/live-key.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "hls.js": "^1.7.3",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0"
  }
}

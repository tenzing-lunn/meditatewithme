# Copy to .env.local. The same two values as the website's NEXT_PUBLIC_ pair;
# the anon key is safe to ship, every table it reaches is behind RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The site the app loads behind its native arrival, and asks for the water,
# the places and sign-in. A local `next dev` instead of the live site, to try
# a change to the site's side of the bridge (components/useAppBridge.ts):
# EXPO_PUBLIC_SITE=http://localhost:3000/

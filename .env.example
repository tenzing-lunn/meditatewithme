# Copy to .env.local and fill in. .env.local is gitignored.

# Safe to expose — every table it reaches is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS completely. No NEXT_PUBLIC_ prefix, so Next.js
# will not inline it into the client bundle. Never import lib/supabase.ts's
# serviceClient() into a component.
SUPABASE_SERVICE_ROLE_KEY=

# Live video (plans/live-video.md). All server only.
# MediaMTX calls /api/live/auth with LIVE_AUTH_SECRET as Basic auth on every
# publish, and /api/live/hook with "Authorization: Bearer LIVE_HOOK_SECRET"
# while a stream is online. Make each with: openssl rand -hex 32
LIVE_AUTH_SECRET=
LIVE_HOOK_SECRET=
# Where viewers read HLS from, e.g. https://live.example.com (local: http://localhost:8888)
LIVE_HLS_BASE=
# Only printed by `npm run live:key`: where collaborators publish to.
LIVE_INGEST_HOST=
